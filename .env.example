# Salin file ini menjadi `apps/api/.env` (API) dan `apps/web/.env.local` (web).
# JANGAN commit file .env berisi kredensial asli.

# ---------- apps/api/.env ----------
NODE_ENV=development
PORT=4000
# Daftar origin yang diizinkan CORS, pisahkan dengan koma
CORS_ORIGINS=http://localhost:3000
# Isi sesuai MySQL lokalmu. Kosongkan bila database belum disiapkan.
# Format: mysql://USER:PASSWORD@HOST:3306/NAMA_DB
DATABASE_URL=
# Origin tempat aplikasi diakses browser (Express melayani EJS). Wajib di production.
APP_ORIGIN=http://localhost:4000
# Rahasia penurunan token CSRF: acak, minimal 32 karakter. Wajib di production. JANGAN di-commit.
CSRF_SECRET=
# Gerbang Admin di /masuk; ganti sebelum server dapat diakses orang lain.
ADMIN_PASSWORD=change-this-local-password
ADMIN_LOGIN_EMAIL=admin@sopinsya

# ---------- apps/web/.env.local ----------
# Base URL API untuk konten publik dan tes peserta.
# Di production isi dengan alamat publik API, bukan localhost.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Opsional: tautan WhatsApp untuk tombol "Hubungi Kami" (mis. https://wa.me/62...).
# Bila kosong, tombol mengarah ke bagian kontak di halaman Tentang Kami.
NEXT_PUBLIC_WHATSAPP_URL=
