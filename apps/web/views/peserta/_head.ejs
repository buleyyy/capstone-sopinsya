<header class="site-header">
  <div class="container header-row">
    <a href="/peserta/" class="brand" aria-label="SopinsyaEducenter, ke beranda">
      <img src="/static/logo.svg" alt="" width="40" height="40" class="brand-logo">
      <span class="brand-text">
        <span class="brand-name">SopinsyaEducenter</span>
        <span class="brand-sub">Peserta</span>
      </span>
    </a>
    <nav aria-label="Menu utama" class="nav">
      <div class="nav-group">
        <a href="/peserta/#program"<%- navKey === 'program' ? ' class="active" aria-current="page"' : '' %>>Program</a>
        <a href="/peserta/tentang-kami"<%- navKey === 'tentang' ? ' class="active" aria-current="page"' : '' %>>Tentang Kami</a>
      </div>
      <% if (wa) { %>
        <a href="<%= wa %>" class="pill" target="_blank" rel="noopener noreferrer">Konsultasi</a>
      <% } else { %>
        <a href="/peserta/tentang-kami#kontak" class="pill">Konsultasi</a>
      <% } %>
    </nav>
  </div>
</header>
<main id="konten">
