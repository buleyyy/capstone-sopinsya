<%- include('_head') %>
<%
  var icons = { 'silabus': 'pdf', 'materi': 'pdf', 'sop': 'pdf', 'studi-kasus': 'doc', 'pre-test': 'doc', 'post-test': 'doc', 'quiz': 'link', 'video': 'link' };
%>
<div class="pd" data-program-slug="<%= program.slug %>" data-program-title="<%= program.fullTitle %>">
  <div class="container">
    <section class="pd-hero" aria-labelledby="pd-title">
      <div class="pd-cover" role="img" aria-label="Ilustrasi program pelatihan"></div>
      <div>
        <a href="/peserta/#program" class="back-link">← Semua Program</a>
        <h1 id="pd-title" class="pd-title"><%= program.fullTitle %></h1>
        <p class="pd-trainer"><svg class="ico" width="16" height="16" aria-hidden="true"><use href="#i-user"/></svg> Trainer: <%= program.trainer %></p>
        <p class="pd-desc"><%= program.description %></p>
        <button type="button" class="btn btn-action" data-join>Ikuti Pelatihan</button>
      </div>
    </section>

    <p class="pd-gate">Klik <strong>Ikuti Pelatihan</strong> untuk membuka silabus, materi, tes, dan sumber belajar program ini.</p>

    <div class="pd-acc">
      <% if (program.meetings.length === 0) { %>
        <p class="pd-empty-all">Belum ada pertemuan yang dipublikasikan untuk program ini.</p>
      <% } %>
      <% sections.forEach(function (s) { %>
        <details class="pd-sec" id="<%= s.id %>">
          <summary>
            <span class="pd-ico" aria-hidden="true"><svg class="ico" width="24" height="24"><use href="#i-book"/></svg></span>
            <span class="pd-sec-title"><%= s.title %></span>
            <span class="pd-chev" aria-hidden="true"><svg class="ico" width="18" height="18"><use href="#i-chevron-down"/></svg></span>
          </summary>
          <% if (s.rows.length === 0) { %>
            <p class="pd-empty">Belum ada konten pada bagian ini.</p>
          <% } else { %>
            <ul class="pd-rows">
              <% s.rows.forEach(function (r) { %>
                <li>
                  <% if (r.kind === 'off') { %>
                    <div class="pd-row pd-row-off" aria-disabled="true"><svg class="ico pd-icon pd-icon-<%= icons[s.id] %>" width="30" height="30" aria-hidden="true"><use href="#i-<%= icons[s.id] %>"/></svg><span><%= r.label %></span><small>Belum tersedia</small></div>
                  <% } else if (r.kind === 'external') { %>
                    <a class="pd-row" href="<%= r.href %>" target="_blank" rel="noopener noreferrer"><svg class="ico pd-icon pd-icon-<%= icons[s.id] %>" width="30" height="30" aria-hidden="true"><use href="#i-<%= icons[s.id] %>"/></svg><span><%= r.label %></span><svg class="ico pd-row-go" width="18" height="18" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
                  <% } else if (r.kind === 'internal') { %>
                    <a class="pd-row" href="<%= r.href %>"><svg class="ico pd-icon pd-icon-<%= icons[s.id] %>" width="30" height="30" aria-hidden="true"><use href="#i-<%= icons[s.id] %>"/></svg><span><%= r.label %></span><svg class="ico pd-row-go" width="18" height="18" aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
                  <% } else { %>
                    <button type="button" class="pd-row" data-test="<%= r.test %>" data-meeting="<%= r.meeting %>"><svg class="ico pd-icon pd-icon-<%= icons[s.id] %>" width="30" height="30" aria-hidden="true"><use href="#i-<%= icons[s.id] %>"/></svg><span><%= r.label %></span><svg class="ico pd-row-go" width="18" height="18" aria-hidden="true"><use href="#i-chevron-right"/></svg></button>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </details>
      <% }) %>
    </div>

    <section class="pd-reviews" aria-labelledby="pd-rev">
      <div class="pd-reviews-head">
        <h2 id="pd-rev">Rating &amp; Ulasan</h2>
        <p>Pengalaman peserta yang telah mengikuti pelatihan ini</p>
      </div>
      <div class="pd-reviews-empty" role="status">
        Rating dan ulasan akan ditampilkan di sini setelah fitur penyimpanan ulasan tersedia. Belum ada ulasan untuk program ini.
      </div>
    </section>
  </div>
</div>
<%- include('_foot') %>
