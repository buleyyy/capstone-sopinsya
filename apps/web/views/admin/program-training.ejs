<%- include('../partials/header') %>
<%
  var KIND = { SILABUS: 'Silabus', MATERI: 'Materi', STUDI_KASUS: 'Studi kasus', VIDEO: 'Video referensi', BLOOKET: 'Quiz Game (Blooket)', LINK_LAIN: 'Tautan lain' };
  var progLabel = function (slug) { var p = programs.find(function (x) { return x.slug === slug; }); return p ? p.label : slug; };
%>
<div class="ad-pagehead">
  <div>
    <h1>Manajemen Program</h1>
    <p>Atur semua konten yang tampil di sisi peserta: konten pendukung, Pre-test, dan Post-test.</p>
  </div>
  <div class="ad-pagehead-actions">
    <% if (tab === 'program' && catalog) { %><a class="btn small ad-primary" href="/admin/program/baru"><svg class="icon sm"><use href="#i-plus"/></svg>Tambah Program</a><% } %>
    <% if (tab === 'materi') { %><a class="btn small ad-primary" href="#tambah-konten"><svg class="icon sm"><use href="#i-plus"/></svg>Tambah Konten</a><% } %>
    <% if (tab === 'tes') { %><a class="btn small ad-primary" href="#tambah-tes"><svg class="icon sm"><use href="#i-plus"/></svg>Tambah Tes</a><% } %>
  </div>
</div>
<% if (saved) { %><div class="alert ok">Perubahan berhasil disimpan.</div><% } %>

<nav class="au-tabs ad-subtabs" aria-label="Bagian manajemen program">
  <a href="/admin/program-training?tab=program"<%- tab === 'program' ? ' class="active" aria-current="page"' : '' %>>Daftar Program</a>
  <a href="/admin/program-training?tab=materi"<%- tab === 'materi' ? ' class="active" aria-current="page"' : '' %>>Materi &amp; Konten</a>
  <a href="/admin/program-training?tab=tes"<%- tab === 'tes' ? ' class="active" aria-current="page"' : '' %>>Pre/Post-test</a>
</nav>

<% if (tab === 'program' && catalog) { var ST = { PUBLISHED: ['on', 'Terbit'], ARCHIVED: ['off', 'Nonaktif'], DRAFT: ['draft', 'Draft'] }; %>
  <div class="ad-card">
    <div class="ad-card-head">
      <div><h2>Daftar Program</h2><p>Katalog program pelatihan</p></div>
    </div>
    <div class="tablewrap">
      <table class="au-table ad-table">
        <thead><tr><th>No</th><th>Nama Program</th><th>Kategori</th><th>Nama Trainer</th><th>Deskripsi</th><th>Konten</th><th>Rating</th><th>Status</th><th>Aksi</th></tr></thead>
        <tbody>
          <% if (catalog.length === 0) { %><tr><td colspan="9" class="au-empty">Belum ada program. Klik "Tambah Program" untuk membuat program pertama.</td></tr><% } %>
          <% catalog.forEach(function (p, i) { var st = ST[p.status] || ST.DRAFT; %>
            <tr>
              <td><%= i + 1 %></td>
              <td><a class="ad-name ad-link" href="/admin/program/<%= p.id %>"><%= p.title %></a></td>
              <td class="muted"><%= p.category || '-' %></td>
              <td><b><%= p.trainer || '-' %></b></td>
              <td class="ad-desc"><%= p.summary.length > 120 ? p.summary.slice(0, 120) + '…' : (p.summary || '-') %></td>
              <td><%= p.resourceCount %></td>
              <td class="nowrap"><% var rt = ratingOf(p.id); if (rt) { %><span class="ad-stars small">★</span> <b><%= rt.average.toFixed(1) %></b> <span class="muted">(<%= rt.count %>)</span><% } else { %><span class="muted">–</span><% } %></td>
              <td><span class="ad-pill <%= st[0] %>"><%= st[1] %></span></td>
              <td class="nowrap">
                <div class="ad-actions ad-icons">
                  <a class="ad-manage" href="/admin/program/<%= p.id %>">Kelola</a>
                  <% if (p.meetingCount === 0) { %>
                    <form method="post" action="/admin/program/<%= p.id %>/hapus"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="au-icon-btn danger" type="submit" aria-label="Hapus program <%= p.title %>" title="Hapus program"><svg class="icon sm"><use href="#i-trash"/></svg></button></form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="au-card-foot"><span>Program berstatus Terbit tampil di katalog peserta. Program hanya bisa dihapus bila belum punya pertemuan.</span></div>
  </div>
<% } else if (tab === 'program') { %>
  <div class="ad-card">
    <div class="ad-card-head"><div><h2>Daftar Program</h2><p>Katalog program pelatihan</p></div></div>
    <div class="tablewrap">
      <table class="au-table ad-table">
        <thead><tr><th>No</th><th>Nama Program</th><th>Kode</th><th>Pertemuan</th><th>Konten</th><th>Tes</th><th>Status</th><th>Aksi</th></tr></thead>
        <tbody>
          <% programs.forEach(function (p, i) { var rs = resources.filter(function (r) { return r.programSlug === p.slug; }); var ts = tests.filter(function (t) { return t.programSlug === p.slug; }); %>
            <tr>
              <td><%= i + 1 %></td>
              <td><b class="ad-name"><%= p.label %></b></td>
              <td class="muted"><%= p.slug %></td>
              <td>1–2</td>
              <td><%= rs.length %></td>
              <td><%= ts.length %></td>
              <td><span class="ad-pill on">Terbit</span></td>
              <td class="nowrap"><div class="ad-actions"><a class="ad-manage" href="/admin/program-training?tab=materi">Kelola</a><a class="ad-manage" href="/admin/program-training?tab=tes">Tes</a></div></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="au-card-foot"><span>Nama dan pertemuan program bersumber dari katalog peserta (<code>apps/web/peserta/programs.ts</code>).</span></div>
  </div>
<% } else if (tab === 'materi') { %>
  <div class="ad-card">
    <div class="ad-card-head"><div><h2>Konten Pendukung</h2><p><%= resources.length %> konten: silabus, materi, studi kasus, quiz game, dan video referensi</p></div></div>
    <div class="tablewrap">
      <table class="au-table ad-table">
        <thead><tr><th>No</th><th>Nama Program</th><th>Jenis</th><th>Judul</th><th>Tautan</th><th>Status</th><th>Aksi</th></tr></thead>
        <tbody>
          <% if (resources.length === 0) { %><tr><td colspan="7" class="au-empty">Belum ada konten pendukung.</td></tr><% } %>
          <% resources.forEach(function (r, i) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><b class="ad-name"><%= progLabel(r.programSlug) %></b><div class="muted small">Pertemuan <%= r.meetingNo %></div></td>
              <td><%= KIND[r.type] %></td>
              <td class="clip"><b><%= r.title %></b><% if (r.description) { %><div class="muted small"><%= r.description %></div><% } %></td>
              <td><a href="<%= r.url %>" target="_blank" rel="noopener noreferrer">Buka tautan</a></td>
              <td><span class="ad-pill <%= r.isPublished ? 'on' : 'draft' %>"><%= r.isPublished ? 'Terbit' : 'Draft' %></span></td>
              <td>
                <div class="ad-actions">
                  <details class="ad-edit"><summary class="ad-manage">Kelola</summary>
                    <form method="post" action="/admin/program-training/resource/<%= r.id %>" class="compact-form">
                      <input type="hidden" name="_csrf" value="<%= csrf %>">
                      <label>Program<select name="programSlug" required><% programs.forEach(function (x) { %><option value="<%= x.slug %>" <%= x.slug === r.programSlug ? 'selected' : '' %>><%= x.label %></option><% }) %></select></label>
                      <label>Pertemuan<select name="meetingNo"><option value="1" <%= r.meetingNo === 1 ? 'selected' : '' %>>Pertemuan 1</option><option value="2" <%= r.meetingNo === 2 ? 'selected' : '' %>>Pertemuan 2</option></select></label>
                      <label>Jenis<select name="type"><% [['SILABUS','Silabus'],['MATERI','Materi'],['STUDI_KASUS','Studi kasus'],['VIDEO','Video'],['BLOOKET','Blooket'],['LINK_LAIN','Tautan lain']].forEach(function (x) { %><option value="<%= x[0] %>" <%= x[0] === r.type ? 'selected' : '' %>><%= x[1] %></option><% }) %></select></label>
                      <label>Judul<input name="title" required maxlength="160" value="<%= r.title %>"></label>
                      <label>Deskripsi<textarea name="description" rows="2" maxlength="4000"><%= r.description || '' %></textarea></label>
                      <label>URL https://<input type="url" name="url" required maxlength="1024" value="<%= r.url %>"></label>
                      <label>Urutan<input type="number" name="sortOrder" min="0" max="100000" value="<%= r.sortOrder %>"></label>
                      <label><input type="checkbox" name="isPublished" value="1" <%= r.isPublished ? 'checked' : '' %>> Dipublikasikan</label>
                      <button class="btn small ad-primary" type="submit">Simpan perubahan</button>
                    </form>
                  </details>
                  <form method="post" action="/admin/program-training/resource/<%= r.id %>/publikasi"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="value" value="<%= r.isPublished ? '0' : '1' %>"><button class="btn outline small" type="submit"><%= r.isPublished ? 'Tarik' : 'Terbitkan' %></button></form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <form method="post" action="/admin/program-training/resource" class="ad-card" id="tambah-konten">
    <div class="ad-card-head"><div><h2>Tambah Konten Program</h2><p>Tautan video, quiz game, studi kasus, silabus, atau materi eksternal</p></div></div>
    <div class="ad-card-body ad-form ad-grid">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div><label for="resource-program">Program <span class="req">*</span></label>
      <select id="resource-program" name="programSlug" required><% programs.forEach(function (p) { %><option value="<%= p.slug %>"><%= p.label %></option><% }) %></select></div>
      <div><label for="resource-meeting">Pertemuan <span class="req">*</span></label>
      <select id="resource-meeting" name="meetingNo" required><option value="1">Pertemuan 1</option><option value="2">Pertemuan 2</option></select></div>
      <div><label for="resource-type">Jenis konten <span class="req">*</span></label>
      <select id="resource-type" name="type" required><option value="VIDEO">Video referensi</option><option value="BLOOKET">Quiz Game (Blooket)</option><option value="STUDI_KASUS">Studi kasus</option><option value="SILABUS">Silabus</option><option value="MATERI">Materi eksternal</option><option value="LINK_LAIN">Tautan lain</option></select></div>
      <div><label for="resource-order">Urutan tampil</label>
      <input id="resource-order" type="number" name="sortOrder" min="0" max="100000" value="0"></div>
      <div class="wide"><label for="resource-title">Judul <span class="req">*</span></label>
      <input id="resource-title" name="title" required maxlength="160" placeholder="mis. Video pengantar ISO 37001"></div>
      <div class="wide"><label for="resource-description">Deskripsi (opsional)</label>
      <textarea id="resource-description" name="description" rows="3" maxlength="4000"></textarea></div>
      <div class="wide"><label for="resource-url">URL https:// <span class="req">*</span></label>
      <input id="resource-url" type="url" name="url" required maxlength="1024" placeholder="https://..."></div>
      <label class="wide ad-check"><input type="checkbox" name="isPublished" value="1"> Langsung tampilkan ke peserta</label>
      <div class="wide ad-form-actions"><button class="btn small ad-primary" type="submit">Simpan Konten</button></div>
    </div>
  </form>
  <p class="muted small">PDF/SOP tetap dikelola melalui <a href="/admin/sop">Pustaka SOP</a>.</p>
<% } else { %>
  <div class="ad-card">
    <div class="ad-card-head"><div><h2>Tes Pelatihan</h2><p><%= tests.length %> tes Pre-test dan Post-test</p></div></div>
    <div class="tablewrap">
      <table class="au-table ad-table">
        <thead><tr><th>No</th><th>Nama Program</th><th>Jenis Test</th><th>Judul</th><th>Soal aktif/total</th><th>Percobaan</th><th>Status</th><th>Aksi</th></tr></thead>
        <tbody>
          <% if (tests.length === 0) { %><tr><td colspan="8" class="au-empty">Belum ada tes.</td></tr><% } %>
          <% tests.forEach(function (t, i) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><b class="ad-name"><%= progLabel(t.programSlug) %></b><div class="muted small">Pertemuan <%= t.meetingNo %></div></td>
              <td><span class="ad-type"><%= t.type === 'PRE' ? 'Pre-test' : 'Post-test' %></span></td>
              <td class="clip"><%= t.title %></td>
              <td><%= questions.filter(function (q) { return q.testId === t.id && q.isActive; }).length %>/<%= t.questionCount %></td>
              <td><%= t.attemptCount %></td>
              <td><span class="ad-pill <%= t.isActive ? 'on' : 'off' %>"><%= t.isActive ? 'Aktif' : 'Nonaktif' %></span></td>
              <td class="nowrap"><div class="ad-actions"><a class="ad-manage" href="/admin/program-training?tab=tes&testId=<%= t.id %>#tambah-soal">Tambah soal</a><form method="post" action="/admin/program-training/test/<%= t.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="value" value="<%= t.isActive ? '0' : '1' %>"><button class="btn outline small" type="submit"><%= t.isActive ? 'Nonaktifkan' : 'Aktifkan' %></button></form></div></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <form method="post" action="/admin/program-training/test" class="ad-card" id="tambah-tes">
    <div class="ad-card-head"><div><h2>Buat / Perbarui Tes</h2><p>Satu tes per program, pertemuan, dan jenis. Kombinasi yang sudah ada hanya diperbarui judul/statusnya.</p></div></div>
    <div class="ad-card-body ad-form ad-grid">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div><label for="test-program">Program <span class="req">*</span></label>
      <select id="test-program" name="programSlug" required><% programs.forEach(function (p) { %><option value="<%= p.slug %>"><%= p.label %></option><% }) %></select></div>
      <div><label for="test-meeting">Pertemuan <span class="req">*</span></label>
      <select id="test-meeting" name="meetingNo" required><option value="1">Pertemuan 1</option><option value="2">Pertemuan 2</option></select></div>
      <div><label for="test-type">Jenis tes <span class="req">*</span></label>
      <select id="test-type" name="type" required><option value="PRE">Pre-test</option><option value="POST">Post-test</option></select></div>
      <div><label for="test-title">Judul tes <span class="req">*</span></label>
      <input id="test-title" name="title" required maxlength="160" placeholder="mis. Pre-test ISO 37001 Pertemuan 1"></div>
      <label class="wide ad-check"><input type="checkbox" name="isActive" value="1" checked> Aktifkan tes</label>
      <div class="wide ad-form-actions"><button class="btn small ad-primary" type="submit">Simpan Tes</button></div>
    </div>
  </form>

  <div class="ad-card">
    <div class="ad-card-head light"><div><h2>Bank Soal</h2><p><%= questions.length %> soal</p></div></div>
    <div class="tablewrap">
      <table class="au-table ad-table">
        <thead><tr><th>No</th><th>Tes</th><th>Pertanyaan</th><th>Jawaban tersimpan</th><th>Status</th><th>Aksi</th></tr></thead>
        <tbody>
          <% if (questions.length === 0) { %><tr><td colspan="6" class="au-empty">Belum ada soal.</td></tr><% } %>
          <% questions.forEach(function (q, i) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><b class="ad-name"><%= progLabel(q.programSlug) %></b><div class="muted small">Pertemuan <%= q.meetingNo %> · <%= q.testType === 'PRE' ? 'Pre-test' : 'Post-test' %></div></td>
              <td class="clip"><%= q.text %></td>
              <td><%= q.answerCount %></td>
              <td><span class="ad-pill <%= q.isActive ? 'on' : 'off' %>"><%= q.isActive ? 'Aktif' : 'Nonaktif' %></span></td>
              <td><form method="post" action="/admin/program-training/question/<%= q.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="value" value="<%= q.isActive ? '0' : '1' %>"><button class="btn outline small" type="submit"><%= q.isActive ? 'Nonaktifkan' : 'Aktifkan' %></button></form></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <% if (tests.length === 0) { %><div class="alert info">Buat tes terlebih dahulu sebelum menambahkan soal.</div><% } else { var chosen = tests.find(function (t) { return t.id === selectedTestId; }) || tests[0]; %>
    <form method="post" action="/admin/program-training/test/<%= chosen.id %>/question" class="ad-card" id="tambah-soal">
      <div class="ad-card-head"><div><h2>Tambah Soal</h2><p><%= chosen.title %></p></div></div>
      <div class="ad-card-body ad-form ad-grid">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="wide"><label for="question-text">Pertanyaan <span class="req">*</span></label>
        <textarea id="question-text" name="text" rows="3" required maxlength="4000"></textarea></div>
        <div><label for="option-a">Pilihan A <span class="req">*</span></label><input id="option-a" name="optionA" required maxlength="500"></div>
        <div><label for="option-b">Pilihan B <span class="req">*</span></label><input id="option-b" name="optionB" required maxlength="500"></div>
        <div><label for="option-c">Pilihan C (opsional)</label><input id="option-c" name="optionC" maxlength="500"></div>
        <div><label for="option-d">Pilihan D (opsional)</label><input id="option-d" name="optionD" maxlength="500"></div>
        <div><label for="correct-option">Kunci jawaban <span class="req">*</span></label>
        <select id="correct-option" name="correctOption" required><option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option></select></div>
        <div class="wide ad-form-actions"><button class="btn small ad-primary" type="submit">Simpan Soal</button></div>
      </div>
    </form>
  <% } %>
  <p class="muted small">Kunci jawaban tetap di server dan tidak dikirim ke peserta. Soal yang sudah dijawab peserta dinonaktifkan, bukan dihapus.</p>
<% } %>
<%- include('../partials/footer') %>
