<%- include('../partials/header') %>
<h1>Kelola Akun Auditor</h1>
<p class="muted">Akun Auditor dibuat dan dikelola di sini, lalu ditugaskan ke sesi audit lewat halaman sesi. Kata sandi disimpan sebagai hash (bcrypt) dan tidak pernah dapat dilihat kembali.</p>
<% if (saved) { %><div class="alert ok">Tersimpan.</div><% } %>

<% if (generated) { %>
  <div class="alert info">
    <strong>Kata sandi sementara untuk <%= generated.name %> (<%= generated.email %>)</strong>
    <p>Salin dan sampaikan sekarang lewat saluran aman. Kata sandi ini <strong>tidak akan ditampilkan lagi</strong> setelah halaman ini ditutup; bila hilang, gunakan "Reset kata sandi".</p>
    <div class="link-box"><%= generated.password %></div>
  </div>
<% } %>

<div class="card tablewrap">
  <table>
    <thead><tr><th>Nama</th><th>Email</th><th>Status</th><th>Login terakhir</th><th>Aksi</th></tr></thead>
    <tbody>
      <% accounts.forEach(function (a) { %>
        <tr>
          <td><%= a.name %></td>
          <td><%= a.email %></td>
          <td><span class="badge <%= a.isActive ? 'active' : 'closed' %>"><%= a.isActive ? 'Aktif' : 'Nonaktif' %></span></td>
          <td><%= a.lastLoginAt ? fmt(a.lastLoginAt) : 'Belum pernah' %></td>
          <td class="nowrap">
            <form class="inline" method="post" action="/admin/akun/<%= a.id %>/status">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="value" value="<%= a.isActive ? '0' : '1' %>">
              <button class="btn small <%= a.isActive ? 'danger' : 'secondary' %>" type="submit"><%= a.isActive ? 'Nonaktifkan' : 'Aktifkan' %></button>
            </form>
          </td>
        </tr>
        <tr>
          <td colspan="5">
            <details>
              <summary>Ubah data atau reset kata sandi: <%= a.name %></summary>
              <form method="post" action="/admin/akun/<%= a.id %>" class="row">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <div><label for="n<%= a.id %>">Nama</label><input id="n<%= a.id %>" type="text" name="name" required maxlength="120" value="<%= a.name %>"></div>
                <div><label for="e<%= a.id %>">Email</label><input id="e<%= a.id %>" type="text" name="email" required maxlength="160" value="<%= a.email %>" autocomplete="off"></div>
                <button class="btn small" type="submit">Simpan</button>
              </form>
              <form method="post" action="/admin/akun/<%= a.id %>/reset-password" class="row">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <div>
                  <label for="p<%= a.id %>">Kata sandi baru (kosong = dibuatkan otomatis)</label>
                  <input id="p<%= a.id %>" type="password" name="password" minlength="10" maxlength="72" autocomplete="new-password">
                </div>
                <button class="btn small secondary" type="submit">Reset kata sandi</button>
              </form>
            </details>
          </td>
        </tr>
      <% }) %>
      <% if (accounts.length === 0) { %><tr><td colspan="5" class="muted">Belum ada akun Auditor.</td></tr><% } %>
    </tbody>
  </table>
</div>

<h2>Buat akun Auditor</h2>
<form method="post" action="/admin/akun" class="card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label for="name">Nama</label>
  <input id="name" type="text" name="name" required maxlength="120">
  <label for="email">Email (dipakai untuk masuk)</label>
  <input id="email" type="text" name="email" required maxlength="160" autocomplete="off" autocapitalize="off" spellcheck="false">
  <label for="password">Kata sandi awal (opsional, minimal 10 karakter)</label>
  <input id="password" type="password" name="password" minlength="10" maxlength="72" autocomplete="new-password">
  <p class="muted small">Kosongkan agar sistem membuat kata sandi sementara yang ditampilkan sekali setelah akun dibuat.</p>
  <p><button class="btn" type="submit">Buat akun</button></p>
</form>
<%- include('../partials/footer') %>
