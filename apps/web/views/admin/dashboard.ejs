<%- include('../partials/header', { nav: 'dashboard' }) %>

<div class="au-switch">
  <details class="au-switch-menu">
    <summary class="au-switch-btn">Masuk ke Dashboard Audit<svg class="icon sm" aria-hidden="true"><use href="#i-chevron-down"/></svg></summary>
    <div class="au-switch-list">
      <% if (sessions.length === 0) { %>
        <a href="/admin/sesi">Belum ada sesi audit, buat sesi</a>
      <% } %>
      <% sessions.forEach(function (x) { %>
        <a href="/admin/audit?sesi=<%= x.id %>"><%= x.title %><small><%= sessionLabel[x.status] %></small></a>
      <% }) %>
    </div>
  </details>
</div>

<section class="au-hero">
  <span class="au-chip"><span class="au-dot" aria-hidden="true"></span>Selamat datang</span>
  <h1>Dashboard Admin</h1>
  <p>Pantau program pelatihan, data peserta, program aktif, dan performa peserta secara real-time.</p>
</section>

<div class="au-stats">
  <div class="au-stat">
    <div class="body">
      <div class="label">Total Program</div>
      <span class="au-stat-ico violet" aria-hidden="true"><svg class="icon sm"><use href="#i-list"/></svg></span>
      <div class="num"><%= cards.programTotal %></div>
    </div>
    <div class="foot neutral blank"></div>
  </div>
  <div class="au-stat">
    <div class="body">
      <div class="label">Program Terbit</div>
      <span class="au-stat-ico green" aria-hidden="true"><svg class="icon sm"><use href="#i-check"/></svg></span>
      <div class="num"><%= cards.published %></div>
    </div>
    <div class="foot ok blank"></div>
  </div>
  <div class="au-stat">
    <div class="body">
      <div class="label">Program Nonaktif</div>
      <span class="au-stat-ico red" aria-hidden="true"><svg class="icon sm"><use href="#i-alert"/></svg></span>
      <div class="num"><%= cards.inactive %></div>
    </div>
    <div class="foot major blank"></div>
  </div>
  <div class="au-stat">
    <div class="body">
      <div class="label">Jumlah Peserta</div>
      <span class="au-stat-ico violet" aria-hidden="true"><svg class="icon sm"><use href="#i-user"/></svg></span>
      <div class="num"><%= cards.participants %></div>
    </div>
    <div class="foot neutral blank"></div>
  </div>
  <div class="au-stat">
    <div class="body">
      <div class="label">Bank Soal</div>
      <span class="au-stat-ico amber" aria-hidden="true"><svg class="icon sm"><use href="#i-file"/></svg></span>
      <div class="num"><%= cards.tests %><small><%= cards.pre %> pre-test / <%= cards.post %> post-test</small></div>
    </div>
    <div class="foot minor blank"></div>
  </div>
</div>

<div class="ad-split">
  <div class="panel">
    <div class="panel-head">
      <div class="card-title">
        <h3>Konten yang dikelola</h3>
        <p class="muted small">Setiap modul admin mengubah halaman peserta berikut.</p>
      </div>
    </div>
    <div class="tablewrap">
      <table class="au-table ad-content">
        <thead><tr><th>Nama Program</th><th>Data</th><th>Tampil di Halaman Peserta</th></tr></thead>
        <tbody>
          <% content.forEach(function (c) { %>
            <tr>
              <td><a class="ad-link" href="<%= c.href %>"><%= c.label %></a></td>
              <td><%= c.count === null ? '—' : c.count %></td>
              <td class="muted"><%= c.page %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card ad-rating">
    <h3>Rating tampil</h3>
    <p class="muted small">Dari <%= rating.count %> ulasan yang sudah tampil</p>
    <div class="ad-rating-score"><b><%= rating.count ? rating.average.toFixed(1) : '–' %></b><span class="ad-stars" aria-label="Rata-rata <%= rating.average %> dari 5"><%= '★'.repeat(Math.round(rating.average)) %><span class="off"><%= '★'.repeat(5 - Math.round(rating.average)) %></span></span></div>
    <ul class="ad-rating-bars">
      <% rating.buckets.forEach(function (b) { %>
        <li><span><%= b.stars %></span><span class="star" aria-hidden="true">★</span><progress max="<%= Math.max(rating.count, 1) %>" value="<%= b.count %>" aria-label="<%= b.stars %> bintang: <%= b.count %> ulasan"></progress><span><%= b.count %></span></li>
      <% }) %>
    </ul>
    <% if (rating.count === 0) { %><p class="muted small">Belum ada ulasan peserta yang tampil.</p><% } %>
  </div>
</div>

<%- include('../partials/footer') %>
