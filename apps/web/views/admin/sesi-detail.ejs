<%- include('../partials/header') %>
<p><a href="/admin/sesi">&larr; Semua sesi</a></p>
<h1><%= session.title %> <span class="badge <%= session.status.toLowerCase() %>"><%= sessionLabel[session.status] %></span></h1>
<p class="muted">
  <% if (session.versionId !== null) { %>Checklist (arsip) <%= session.standardCode %> <%= session.versionLabel %> &middot; <% } else { %>Tanpa checklist &middot; <% } %>Batas tulis: <%= fmt(session.expiresAt) %>
  <% if (session.closedAt) { %> &middot; Ditutup: <%= fmt(session.closedAt) %><% } %>
  <% if (session.status === 'CLOSED') { %> &middot; Akses auditor sampai: <%= session.auditorAccessUntil ? fmt(session.auditorAccessUntil) : 'tidak ada' %><% } %>
</p>
<% if (saved) { %><div class="alert ok">Tersimpan.</div><% } %>

<h2>Status sesi</h2>
<div class="card">
  <% if (session.status === 'DRAFT') { %>
    <form method="post" action="/admin/sesi/<%= session.id %>/aktifkan">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <p>Aktifkan sesi agar auditor yang ditugaskan dapat bekerja. Pastikan akun Auditor sudah ditugaskan ke sesi ini.</p>
      <button class="btn" type="submit">Aktifkan sesi</button>
    </form>
  <% } else if (session.status === 'ACTIVE') { %>
    <form method="post" action="/admin/sesi/<%= session.id %>/perpanjang" class="row">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div>
        <label for="to">Perpanjang batas tulis (WIB)</label>
        <input id="to" type="datetime-local" name="to" required>
      </div>
      <button class="btn secondary" type="submit">Perpanjang</button>
    </form>
    <hr>
    <form method="post" action="/admin/sesi/<%= session.id %>/tutup">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <fieldset>
        <legend>Tutup sesi (tidak dapat dibuka kembali)</legend>
        <label class="check"><input type="radio" name="mode" value="noAccess" checked> Auditor langsung kehilangan akses</label>
        <label class="check"><input type="radio" name="mode" value="until"> Auditor masih boleh melihat dan menutup temuan sampai:</label>
        <input type="datetime-local" name="accessUntil" aria-label="Akses auditor sampai (WIB)">
      </fieldset>
      <button class="btn danger" type="submit">Tutup sesi</button>
    </form>
  <% } else { %>
    <p class="muted">Sesi sudah ditutup. Tidak ada tindakan status yang tersedia.</p>
  <% } %>
</div>

<h2>Auditor yang ditugaskan</h2>
<div class="card tablewrap">
  <table>
    <thead><tr><th>Nama</th><th>Akun</th><th>Status</th><th>Unit terlarang</th><th></th></tr></thead>
    <tbody>
      <% auditors.forEach(function (a) { %>
        <tr>
          <td><%= a.name %></td>
          <td><%= a.email ? a.email : 'Undangan lama (data historis)' %></td>
          <td><span class="badge <%= a.state.toLowerCase() %>"><%= inviteLabel[a.state] %></span></td>
          <td><%= a.excluded.length ? a.excluded.join(', ') : '-' %></td>
          <td class="nowrap">
            <% if (a.state !== 'DICABUT') { %>
              <form class="inline" method="post" action="/admin/sesi/<%= session.id %>/auditor/<%= a.id %>/cabut">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button class="btn small danger" type="submit">Cabut penugasan</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (auditors.length === 0) { %><tr><td colspan="5" class="muted">Belum ada auditor yang ditugaskan.</td></tr><% } %>
    </tbody>
  </table>
</div>

<% if (session.status !== 'CLOSED') { %>
  <form method="post" action="/admin/sesi/<%= session.id %>/auditor" class="card">
    <h3>Tugaskan akun Auditor</h3>
    <p class="muted small">Auditor masuk lewat halaman Masuk dengan akunnya sendiri dan hanya melihat sesi yang ditugaskan kepadanya. Buat akun di <a href="/admin/akun">Kelola Akun</a>.</p>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% if (accounts.length === 0) { %>
      <div class="alert info">Tidak ada akun Auditor aktif yang tersedia untuk ditugaskan.</div>
    <% } else { %>
      <label for="accountId">Akun Auditor</label>
      <select id="accountId" name="accountId" required>
        <option value="">Pilih...</option>
        <% accounts.forEach(function (acc) { %><option value="<%= acc.id %>"><%= acc.name %> (<%= acc.email %>)</option><% }) %>
      </select>
      <fieldset>
        <legend>Unit yang tidak boleh diaudit auditor ini (cegah self-audit)</legend>
        <% departments.forEach(function (d) { %>
          <label class="check"><input type="checkbox" name="exclude" value="<%= d.id %>"> <%= d.name %></label>
        <% }) %>
        <label class="check"><input type="checkbox" name="noExclusions" value="1"> Tidak ada unit terlarang untuk auditor ini</label>
        <p class="muted small">Pilih unit asal auditor, atau centang "tidak ada". Salah satunya wajib.</p>
      </fieldset>
      <p><button class="btn" type="submit">Tugaskan ke sesi</button></p>
    <% } %>
  </form>
<% } %>

<h2>Penugasan</h2>
<div class="card tablewrap">
  <table>
    <thead><tr><th>Auditor</th><th>Unit diaudit</th><th>Pengisian</th><th>YA</th><th>TIDAK</th><th>Temuan</th></tr></thead>
    <tbody>
      <% assignments.forEach(function (a) { %>
        <tr>
          <td><%= a.auditorName %></td>
          <td><%= a.departmentName %></td>
          <td><%= percent(a.answered, a.total) %>% <span class="muted small">(<%= a.answered %>/<%= a.total %>)</span></td>
          <td><%= a.ya %></td>
          <td><%= a.tidak %></td>
          <td><%= a.findings %></td>
        </tr>
      <% }) %>
      <% if (assignments.length === 0) { %><tr><td colspan="6" class="muted">Belum ada penugasan.</td></tr><% } %>
    </tbody>
  </table>
</div>

<% if (session.status !== 'CLOSED' && auditors.length > 0) { %>
  <form method="post" action="/admin/sesi/<%= session.id %>/penugasan" class="card">
    <h3>Tambah penugasan</h3>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label for="auditorId">Auditor</label>
    <select id="auditorId" name="auditorId" required>
      <option value="">Pilih...</option>
      <% auditors.filter(function (a) { return a.state !== 'DICABUT'; }).forEach(function (a) { %><option value="<%= a.id %>"><%= a.name %></option><% }) %>
    </select>
    <label for="departmentId">Unit yang diaudit</label>
    <select id="departmentId" name="departmentId" required>
      <option value="">Pilih...</option>
      <% departments.forEach(function (d) { %><option value="<%= d.id %>"><%= d.name %></option><% }) %>
    </select>
    <p class="muted small">Sistem menolak penugasan ke unit yang dilarang bagi auditor tersebut.</p>
    <p><button class="btn" type="submit">Tambah penugasan</button></p>
  </form>
<% } %>

<h2>Register Temuan sesi ini</h2>
<div class="card tablewrap">
  <table>
    <thead><tr><th>Kode</th><th>Klasifikasi</th><th>Unit</th><th>Auditor</th><th>Masalah</th><th>Status</th></tr></thead>
    <tbody>
      <% findings.forEach(function (f) { %>
        <tr>
          <td class="nowrap"><%= f.code %></td>
          <td><span class="badge <%= f.classification.toLowerCase() %>"><%= classLabel[f.classification] %></span></td>
          <td><%= f.departmentName %></td>
          <td><%= f.auditorName %></td>
          <td><%= f.problem %></td>
          <td><span class="badge <%= f.status.toLowerCase() %>"><%= f.status === 'OPEN' ? 'Terbuka' : 'Ditutup' %></span></td>
        </tr>
      <% }) %>
      <% if (findings.length === 0) { %><tr><td colspan="6" class="muted">Belum ada temuan.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
