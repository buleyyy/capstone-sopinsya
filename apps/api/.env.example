NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
# mysql://USER:PASSWORD@HOST:3306/NAMA_DB  (kosongkan jika DB belum siap)
DATABASE_URL=
# Origin tempat aplikasi diakses browser (Express melayani EJS). Wajib di production.
APP_ORIGIN=http://localhost:4000
# Rahasia penurunan token CSRF: acak, minimal 32 karakter. Wajib di production. JANGAN di-commit.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=
