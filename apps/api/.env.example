NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
# mysql://USER:PASSWORD@HOST:3306/NAMA_DB  (kosongkan jika DB belum siap)
DATABASE_URL=
# Origin tempat aplikasi diakses browser (Express melayani EJS). Wajib di production.
APP_ORIGIN=http://localhost:4000
# Rahasia penurunan token CSRF: acak, minimal 32 karakter. Wajib di production. JANGAN di-commit.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=
# Gerbang masuk bersama Admin + Auditor (/masuk): email + kata sandi, tanpa kode undangan.
# Email hanya memilih peran; kredensial berbeda: Admin = ADMIN_PASSWORD, Auditor = AUDITOR_PASSWORD.
# Kedua kata sandi minimal 8 karakter (12 di production); kosong = login peran itu nonaktif. JANGAN di-commit.
# Akun Auditor memakai auditor pertama pada sesi ACTIVE terbaru: Admin harus membuat sesi, menambah auditor, dan penugasan.
ADMIN_PASSWORD=admin123
AUDITOR_PASSWORD=auditor123
ADMIN_LOGIN_EMAIL=admin@sopinsya
AUDITOR_LOGIN_EMAIL=auditor@sopinsya
