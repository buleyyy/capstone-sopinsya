NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
# mysql://USER:PASSWORD@HOST:3306/NAMA_DB  (kosongkan jika DB belum siap)
DATABASE_URL=
# Origin tempat aplikasi diakses browser (Express melayani EJS). Wajib di production.
APP_ORIGIN=http://localhost:4000
# Rahasia penurunan token CSRF: acak, minimal 32 karakter. Wajib di production. JANGAN di-commit.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=
# Gerbang login bersama di /masuk. Admin memakai ADMIN_LOGIN_EMAIL + ADMIN_PASSWORD.
# Auditor TIDAK memakai variabel environment: akun Auditor (email + kata sandi) dibuat Admin di halaman /admin/auditor.
# Lokal: minimal 8 karakter; production: minimal 12 karakter. Ganti sebelum server dapat diakses orang lain.
# JANGAN commit kredensial asli.
ADMIN_PASSWORD=change-this-local-password
ADMIN_LOGIN_EMAIL=admin@sopinsya
