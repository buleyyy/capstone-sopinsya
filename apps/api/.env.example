NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
# mysql://USER:PASSWORD@HOST:3306/NAMA_DB  (kosongkan jika DB belum siap)
DATABASE_URL=
# Origin tempat aplikasi diakses browser (Express melayani EJS). Wajib di production.
APP_ORIGIN=http://localhost:4000
# Rahasia penurunan token CSRF: acak, minimal 32 karakter. Wajib di production. JANGAN di-commit.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# ---------------------------------------------------------------------------------------------
# AUTENTIKASI UTAMA: akun di database (tabel UserAccount, kata sandi di-hash bcrypt).
# Admin pertama dibuat sekali lewat:  npm run db:bootstrap-admin
# Isi tiga variabel di bawah, jalankan perintahnya, lalu KOSONGKAN lagi (jangan simpan kata sandi di .env).
# Akun Auditor dibuat Admin lewat menu Kelola Akun, lalu ditugaskan ke sesi audit.
# ---------------------------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# ---------------------------------------------------------------------------------------------
# FALLBACK SEMENTARA (hanya development, DILARANG di production). Rencana penghapusan: docs/AUTH-ACCOUNTS.md.
# false (bawaan) = kata sandi di bawah diabaikan. true = login /masuk dengan kata sandi environment masih diterima.
# ---------------------------------------------------------------------------------------------
LEGACY_ENV_LOGIN=false
ADMIN_PASSWORD=
AUDITOR_PASSWORD=
ADMIN_LOGIN_EMAIL=admin@sopinsya
AUDITOR_LOGIN_EMAIL=auditor@sopinsya
