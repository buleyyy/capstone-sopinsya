<%- include('partials/header', { wide: true }) %>
<div class="gate-card">
  <div class="gate-side">
    <div>
      <div class="brand">
        <span class="side-logo"><svg class="icon"><use href="#i-shield"/></svg></span>
        <span><strong>SOPINSYA</strong><small>SMAP ISO 37001</small></span>
      </div>
      <h2>Integritas tanpa kompromi, tata kelola yang akuntabel</h2>
      <p class="small">Platform pelatihan dan audit internal Sistem Manajemen Anti Penyuapan (ISO 37001).</p>
    </div>
    <ul class="pillars">
      <li><b>No Bribery</b><span>Hindari penyuapan</span></li>
      <li><b>No Kickback</b><span>Tanpa komisi ilegal</span></li>
      <li><b>No Gift</b><span>Tolak gratifikasi</span></li>
      <li><b>No Extortion</b><span>Cegah pemerasan</span></li>
    </ul>
  </div>
  <div class="gate-form">
    <span class="eyebrow">Otentikasi Kepatuhan</span>
    <h1>Masuk ke Portal Audit SMAP</h1>
    <p class="muted">Masuk dengan akun staf yang sesuai. Admin menggunakan <code>admin@sopinsya</code>, sedangkan Auditor menggunakan <code>auditor@sopinsya</code>. Peserta pelatihan tidak perlu masuk.</p>

    <% if (error) { %>
      <div class="alert error" role="alert"><svg class="icon"><use href="#i-alert"/></svg><div><%= error %></div></div>
    <% } %>

    <form method="post" action="/masuk" autocomplete="off">
      <label for="email">Email</label>
      <div class="field-icon">
        <svg class="icon"><use href="#i-mail"/></svg>
        <input id="email" type="text" name="email" required maxlength="120" value="<%= email %>" autocomplete="username" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="admin@sopinsya atau auditor@sopinsya">
      </div>
      <label for="secret">Kata sandi</label>
      <div class="field-icon">
        <svg class="icon"><use href="#i-lock"/></svg>
        <input id="secret" type="password" name="secret" required maxlength="256" autocomplete="current-password" autocapitalize="off" autocorrect="off" spellcheck="false">
      </div>
      <div class="form-actions"><button class="btn block" type="submit">Masuk ke Sistem <svg class="icon sm"><use href="#i-arrow"/></svg></button></div>
    </form>

    <div class="role-grid">
      <section>
        <h3><svg class="icon sm"><use href="#i-shield"/></svg>Admin</h3>
        <p>Email <code><%= adminEmail %></code> dan kata sandi Admin. Masuk ke Dashboard Admin.</p>
        <% if (!adminEnabled) { %><p class="hint">Login Admin belum diaktifkan di server.</p><% } %>
      </section>
      <section>
        <h3><svg class="icon sm"><use href="#i-checklist"/></svg>Auditor</h3>
        <p>Email <code><%= auditorEmail %></code> dan kata sandi Auditor. Setelah berhasil, sistem membuka Dashboard Audit.</p>
        <% if (!auditorEnabled) { %><p class="hint">Login Auditor belum diaktifkan. Admin perlu mengatur <code>AUDITOR_PASSWORD</code> pada environment server.</p><% } %>
      </section>

    </div>
  </div>
</div>
<%- include('partials/footer') %>
