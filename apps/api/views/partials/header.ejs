<%
  var role = (locals.audit || locals.auditorNoSession) ? 'auditor' : (locals.csrfBinding ? 'admin' : null);
  var navKey = locals.nav || '';
  var units = locals.navUnits || [];
  var curUnit = locals.assignment ? locals.assignment.id : null;
  var adminGroups = [
    { label: 'Administrasi SMAP', items: [
      { key: 'dashboard', href: '/admin', icon: 'dashboard', label: 'Dashboard' },
      { key: 'sesi', href: '/admin/sesi', icon: 'calendar', label: 'Sesi Audit' },
      { key: 'auditor', href: '/admin/auditor', icon: 'users', label: 'Akun Auditor' }
    ] },
    { label: 'Data Master', items: [
      { key: 'checklist', href: '/admin/checklist', icon: 'checklist', label: 'Master Checklist' },
      { key: 'departemen', href: '/admin/departemen', icon: 'building', label: 'Departemen' },
      { key: 'sop', href: '/admin/sop', icon: 'folder', label: 'Pustaka SOP' },
      { key: 'program-training', href: '/admin/program-training', icon: 'book', label: 'Program Training' }
    ] }
  ];
  var auditorItems = [
    { key: 'dashboard', href: '/auditor', icon: 'dashboard', label: 'Dashboard Audit' },
    { key: 'sop', href: '/auditor/sop', icon: 'folder', label: 'Pustaka SOP' }
  ];
%><!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> - Sopinsya Educenter</title>
  <link rel="stylesheet" href="/static/app.css">
</head>
<body class="<%= role ? 'role-' + role : 'gate' %>">
<svg class="sprite" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.5-3.2 8.2-8 9-4.8-.8-8-4.5-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></symbol>
    <symbol id="i-dashboard" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></symbol>
    <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18M9 16l2 2 4-4"/></symbol>
    <symbol id="i-checklist" viewBox="0 0 24 24"><path d="M9 6h11M9 12h11M9 18h11"/><path d="M3.5 6l1.5 1.5L7 5M3.5 12l1.5 1.5L7 11M3.5 18l1.5 1.5L7 17"/></symbol>
    <symbol id="i-building" viewBox="0 0 24 24"><path d="M4 21V5a1 1 0 011-1h9a1 1 0 011 1v16M15 9h4a1 1 0 011 1v11M3 21h18M8 8h3M8 12h3M8 16h3"/></symbol>
    <symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/></symbol>
    <symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 3l10 18H2L12 3z"/><path d="M12 10v5M12 18h.01"/></symbol>
    <symbol id="i-logout" viewBox="0 0 24 24"><path d="M9 4H5a2 2 0 00-2 2v12a2 2 0 002 2h4M16 8l4 4-4 4M20 12H9"/></symbol>
    <symbol id="i-chevron" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></symbol>
    <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
    <symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></symbol>
    <symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></symbol>
    <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0113 0M16 4.5a3.5 3.5 0 010 7M21.5 20a6 6 0 00-4-5.6"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0116 0"/></symbol>
    <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></symbol>
    <symbol id="i-file" viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8l-5-5z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></symbol>
    <symbol id="i-x" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
    <symbol id="i-print" viewBox="0 0 24 24"><path d="M7 9V4h10v5M7 17H5a2 2 0 01-2-2v-4a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2h-2"/><rect x="7" y="14" width="10" height="6" rx="1"/></symbol>
    <symbol id="i-link" viewBox="0 0 24 24"><path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1"/></symbol>
    <symbol id="i-external" viewBox="0 0 24 24"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5"/></symbol>
    <symbol id="i-flag" viewBox="0 0 24 24"><path d="M5 21V4M5 4h11l-2 4 2 4H5"/></symbol>
    <symbol id="i-trend" viewBox="0 0 24 24"><path d="M3 17l6-6 4 4 8-8M15 7h6v6"/></symbol>
    <symbol id="i-book" viewBox="0 0 24 24"><path d="M4 5a2 2 0 012-2h13v15H6a2 2 0 00-2 2V5z"/><path d="M4 20a2 2 0 002 1h13v-3"/></symbol>
    <symbol id="i-key" viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M16 7l3 3"/></symbol>
    <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></symbol>
    <symbol id="i-refresh" viewBox="0 0 24 24"><path d="M20 11a8 8 0 00-14.9-3M4 4v4h4M4 13a8 8 0 0014.9 3M20 20v-4h-4"/></symbol>
    <symbol id="i-ban" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/></symbol>
    <symbol id="i-play" viewBox="0 0 24 24"><path d="M7 5l12 7-12 7V5z"/></symbol>
    <symbol id="i-stop" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2"/></symbol>
    <symbol id="i-save" viewBox="0 0 24 24"><path d="M5 4h11l3 3v13H5V4z"/><path d="M8 4v5h7V4M8 20v-6h8v6"/></symbol>
    <symbol id="i-edit" viewBox="0 0 24 24"><path d="M4 20h4L19 9l-4-4L4 16v4z"/><path d="M13 7l4 4"/></symbol>
    <symbol id="i-timer" viewBox="0 0 24 24"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M9 2h6"/></symbol>
  </defs>
</svg>
<% if (role) { %>
<a class="skip" href="#konten">Lewati ke konten</a>
<div class="app">
  <aside class="sidebar">
    <a class="side-brand" href="<%= role === 'admin' ? '/admin' : '/auditor' %>">
      <span class="side-logo"><svg class="icon"><use href="#i-shield"/></svg></span>
      <span><strong>SOPINSYA</strong><small>SMAP ISO 37001</small></span>
    </a>
    <div class="side-body">
      <div class="side-role">
        <small>Peran Aktif</small>
        <b><span class="dot"></span><%= role === 'admin' ? 'Administrator SMAP' : 'Auditor Lapangan' %></b>
      </div>
      <nav class="side-nav" aria-label="Navigasi utama">
        <% if (role === 'admin') { %>
          <% adminGroups.forEach(function (g) { %>
            <div class="nav-label"><%= g.label %></div>
            <% g.items.forEach(function (it) { %>
              <a href="<%= it.href %>"<%- it.key === navKey ? ' class="active" aria-current="page"' : '' %>><svg class="icon"><use href="#i-<%= it.icon %>"/></svg><span><%= it.label %></span></a>
            <% }) %>
          <% }) %>
        <% } else { %>
          <div class="nav-label">Ruang Kerja Auditor</div>
          <% auditorItems.forEach(function (it) { %>
            <a href="<%= it.href %>"<%- (it.key === navKey && !curUnit) ? ' class="active" aria-current="page"' : '' %>><svg class="icon"><use href="#i-<%= it.icon %>"/></svg><span><%= it.label %></span></a>
          <% }) %>
          <% if (units.length > 0) { %>
            <div class="nav-label">Unit yang Diaudit</div>
            <% units.forEach(function (u) { %>
              <a href="/auditor/penugasan/<%= u.id %>"<%- u.id === curUnit ? ' class="active" aria-current="page"' : '' %>><svg class="icon"><use href="#i-building"/></svg><span><%= u.name %></span></a>
            <% }) %>
          <% } %>
        <% } %>
      </nav>
    </div>
    <div class="side-foot">
      <div class="seal"><svg class="icon sm"><use href="#i-shield"/></svg>ISO 37001:2016 Compliant</div>
      Integritas Sistem Anti-Penyuapan
    </div>
  </aside>
  <div class="content">
    <header class="topbar">
      <div class="topbar-in">
        <div class="crumbs">
          <svg class="icon sm"><use href="#i-shield"/></svg>
          <span><%= role === 'admin' ? 'Portal Administrasi SMAP' : 'Ruang Kerja Auditor' %></span>
          <svg class="icon sm"><use href="#i-chevron"/></svg>
          <b><%= title %></b>
        </div>
        <div class="top-right">
          <% if (role === 'auditor' && locals.sessionTitle) { %>
            <span class="top-chip" title="Sesi audit aktif"><svg class="icon sm"><use href="#i-calendar"/></svg><span><%= locals.sessionTitle %></span></span>
            <span class="top-sep"></span>
          <% } %>
          <div class="top-user">
            <div class="who"><b><%= role === 'admin' ? 'Administrator' : (locals.auditorName || 'Auditor') %></b><span><%= role === 'admin' ? 'Administrator SMAP' : 'Auditor Lapangan' %></span></div>
            <span class="avatar" aria-hidden="true"><%= role === 'admin' ? 'A' : 'U' %></span>
            <% if (locals.csrf) { %>
              <form method="post" action="<%= role === 'admin' ? '/admin/keluar' : '/auditor/keluar' %>">
                <input type="hidden" name="_csrf" value="<%= locals.csrf %>">
                <button class="btn soft small" type="submit"><svg class="icon sm"><use href="#i-logout"/></svg>Keluar</button>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    </header>
    <main class="main" id="konten">
<% } else { %>
<main class="gate-main">
<div class="gate-wrap<%= locals.wide ? ' wide' : '' %>">
<% } %>
