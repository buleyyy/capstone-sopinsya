// Schema audit internal ISO 37001 / SMAP (Checklist Audit, Register Temuan, Pustaka SOP).
//
// Prinsip:
//  - Banyak standar dan versi checklist boleh dipakai bersamaan (AuditStandard -> ChecklistVersion).
//    Versi PUBLISHED tidak boleh diubah (ditegakkan di service); perubahan = versi baru.
//  - Satu AuditSession terikat pada satu ChecklistVersion yang tetap (checklistVersionId).
//  - MaterialCategory (Program) TERPISAH dari Department (unit yang diaudit).
//  - Auditor TIDAK punya departemen asal. Self-audit dicegah lewat AuditorExclusion
//    (unit yang dilarang diaudit oleh auditor tertentu, dideklarasikan Admin saat membuat undangan).
//  - Akses lewat undangan per auditor: hanya hash yang disimpan (inviteHash, tokenHash).
//  - Semua relasi rantai audit memakai onDelete: Restrict (tidak ada penghapusan beruntun).
//  - Invarian lintas tabel dijaga foreign key komposit (lihat komentar @@unique "target FK").
//  - Pre-test/Post-test peserta (Test, TestQuestion, TestOption, TestAttempt, TestAttemptAnswer) ada di schema ini.
//    Test tetap diikat lewat programSlug + meetingNo (bukan FK) walau Program/Pertemuan kini juga ada di basis
//    data (TrainingProgram/ProgramMeeting/MeetingResource, dikelola lewat Admin Kelola Program) -- keputusan
//    2026-11-08: jangan ubah mekanisme tes existing. Modul kuis (RD lama) sengaja TIDAK ada.
//  - Belum dimodelkan (menunggu konfirmasi klien): tindak lanjut/verifikasi temuan lanjutan,
//    banyak tautan bukti, skor/persentase audit.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Enum (nilai harus identik dengan src/domain/auditSchemas.ts; dijaga tests/auditSchemas.test.ts) ----------

enum AnswerResult {
  YA
  TIDAK
}

enum FindingClass {
  MAJOR
  MINOR
  OBSERVASI
}

enum FindingStatus {
  OPEN
  CLOSED
}

enum SessionStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ChecklistVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// ---------- Pre-test / Post-test peserta (publik, tanpa login) ----------

enum TestType {
  PRE
  POST
}

enum TrainingResourceType {
  SILABUS
  MATERI
  STUDI_KASUS
  VIDEO
  BLOOKET
  LINK_LAIN
}

// ---------- Kelola Program (Admin Course Builder) ----------
// Program/Pertemuan/Konten sungguhan di basis data (migrasi 20261028120000_training_programs, diterapkan
// sebelum model ini direkonsiliasi ke schema.prisma). Test/TrainingResource TETAP memakai programSlug/meetingNo
// (tidak diubah jadi FK) agar mekanisme pre/post-test existing tidak tersentuh, sesuai keputusan 2026-11-08.

enum MeetingResourceType {
  SOP
  SYLLABUS
  MATERIAL
  CASE_STUDY
  BLOOKET
  VIDEO
}

enum TrainingProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Katalog program (Course Builder Admin). isPublished dipertahankan dan disinkronkan oleh service dari `status`
// (status = PUBLISHED) agar baris lama/ekspektasi lama tidak patah; `status` adalah sumber kebenaran lifecycle.
model TrainingProgram {
  id          Int                   @id @default(autoincrement())
  slug        String                @unique @db.VarChar(80)
  code        String                @db.VarChar(10)
  title       String                @db.VarChar(80)
  fullTitle   String                @db.VarChar(120)
  subtitle    String                @db.VarChar(160)
  summary     String                @db.VarChar(300)
  description String                @db.Text
  duration    String                @db.VarChar(40)
  mode        String                @db.VarChar(40)
  trainer     String                @db.VarChar(120)
  category    String                @db.VarChar(60)
  tone        String                @default("blue") @db.VarChar(10)
  sortOrder   Int                   @default(0)
  isPublished Boolean               @default(false)
  status      TrainingProgramStatus @default(DRAFT)
  coverUrl    String?               @db.VarChar(255) // /berkas/<id>/<nama> (unggahan Admin) atau https://
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  meetings    ProgramMeeting[]
  reviews     ProgramReview[]
  caseStudies CaseStudySubmission[]

  @@index([isPublished, sortOrder])
  @@index([status, sortOrder])
}

model ProgramMeeting {
  id          Int               @id @default(autoincrement())
  programId   Int
  number      Int
  title       String            @db.VarChar(160)
  sortOrder   Int               @default(0)
  isPublished Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  program     TrainingProgram   @relation(fields: [programId], references: [id], onDelete: Restrict)
  resources   MeetingResource[]

  @@unique([programId, number])
  @@index([programId, isPublished, sortOrder])
}

model MeetingResource {
  id          Int                 @id @default(autoincrement())
  meetingId   Int
  type        MeetingResourceType
  title       String              @db.VarChar(200)
  url         String              @db.VarChar(1024)
  sortOrder   Int                 @default(0)
  isPublished Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  meeting     ProgramMeeting      @relation(fields: [meetingId], references: [id], onDelete: Restrict)

  @@index([meetingId, type, isPublished, sortOrder])
}

// Satu tes per jenis per pertemuan. Program/pertemuan belum ada di basis data, jadi diikat lewat slug + nomor.
model Test {
  id          Int            @id @default(autoincrement())
  programSlug String         @db.VarChar(80)
  meetingNo   Int
  type        TestType
  title       String         @db.VarChar(160)
  instructions String?       @db.Text // petunjuk pengerjaan untuk peserta
  shuffleQuestions Boolean   @default(false) // acak urutan soal setiap kali peserta membuka tes
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  questions   TestQuestion[]
  attempts    TestAttempt[]

  @@unique([programSlug, meetingNo, type])
}

// Soal tidak dihapus fisik bila sudah punya jawaban; cukup isActive = false agar riwayat konsisten.
model TestQuestion {
  id       Int                 @id @default(autoincrement())
  testId   Int
  orderNo  Int
  text     String              @db.Text
  isActive Boolean             @default(true)
  test     Test                @relation(fields: [testId], references: [id], onDelete: Restrict)
  options  TestOption[]
  answers  TestAttemptAnswer[]

  @@index([testId, orderNo])
}

// Opsi A-D. isCorrect (kunci jawaban) tidak pernah dikirim ke peserta.
model TestOption {
  id         Int                 @id @default(autoincrement())
  questionId Int
  label      String              @db.VarChar(1)
  text       String              @db.VarChar(500)
  isCorrect  Boolean             @default(false)
  question   TestQuestion        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answers    TestAttemptAnswer[]

  @@unique([questionId, label])
}

// Satu baris per percobaan. Identitas peserta berupa nama + instansi (tanpa akun login).
model TestAttempt {
  id                     Int                 @id @default(autoincrement())
  testId                 Int
  participantName        String              @db.VarChar(120)
  participantInstitution String              @db.VarChar(160)
  participantEmail       String?             @db.VarChar(160)
  participantPosition    String?             @db.VarChar(120) // jabatan
  participantPhone       String?             @db.VarChar(30)
  deletedAt              DateTime? // dihapus Admin dari rekap (jawaban tetap tersimpan)
  clientRequestId        String              @db.VarChar(64) // kunci idempotensi: klik Selesai ganda = satu percobaan
  correctCount           Int
  totalQuestions         Int
  score                  Int // (correctCount / totalQuestions) * 100, dibulatkan
  submittedAt            DateTime            @default(now())
  test                   Test                @relation(fields: [testId], references: [id], onDelete: Restrict)
  answers                TestAttemptAnswer[]

  @@unique([testId, clientRequestId])
  @@index([testId, submittedAt])
}

model TestAttemptAnswer {
  id         Int           @id @default(autoincrement())
  attemptId  Int
  questionId Int
  optionId   Int? // null = soal tidak dijawab (dihitung salah)
  isCorrect  Boolean
  attempt    TestAttempt   @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  question   TestQuestion  @relation(fields: [questionId], references: [id], onDelete: Restrict)
  option     TestOption?   @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([optionId])
}

// Konten pendukung yang dikelola Admin dan ditautkan ke program/pertemuan statis saat ini.
// URL eksternal divalidasi https di service; konten draft tidak diterbitkan ke halaman publik.
model TrainingResource {
  id          Int                  @id @default(autoincrement())
  programSlug String               @db.VarChar(80)
  meetingNo   Int
  type        TrainingResourceType
  title       String               @db.VarChar(160)
  description String?              @db.Text
  url         String               @db.VarChar(1024)
  sortOrder   Int                  @default(0)
  isPublished Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([programSlug, meetingNo, isPublished, sortOrder])
}

// ---------- Konten situs (diedit Admin lewat /admin/pengaturan) ----------
// key "about" = halaman Tentang Kami peserta. Migrasi 20261111120000_site_content (aditif).
/// Berkas unggahan situs pelatihan: sampul program & materi (publik), serta tugas studi kasus peserta (hanya Admin).
model StoredFile {
  id          Int      @id @default(autoincrement())
  purpose     String   @db.VarChar(20) // COVER | MATERIAL | CASE_STUDY
  fileName    String   @db.VarChar(200)
  contentType String   @db.VarChar(100)
  sizeBytes   Int
  data        Bytes    @db.LongBlob
  createdAt   DateTime @default(now())
  caseStudies CaseStudySubmission[]

  @@index([purpose])
}

/// Rating & ulasan peserta untuk satu program. Admin dapat menyembunyikan ulasan (isVisible=false).
model ProgramReview {
  id              Int             @id @default(autoincrement())
  programId       Int
  reviewerName    String          @db.VarChar(120)
  rating          Int // 1..5
  comment         String          @db.Text
  isVisible       Boolean         @default(true)
  clientRequestId String          @db.VarChar(64)
  createdAt       DateTime        @default(now())
  program         TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, clientRequestId])
  @@index([programId, isVisible, createdAt])
}

/// Tugas studi kasus yang diunggah peserta untuk satu pertemuan program.
model CaseStudySubmission {
  id                     Int             @id @default(autoincrement())
  programId              Int
  meetingNo              Int
  participantName        String          @db.VarChar(120)
  participantInstitution String          @db.VarChar(160)
  participantEmail       String?         @db.VarChar(160)
  fileId                 Int
  submittedAt            DateTime        @default(now())
  deletedAt              DateTime?
  program                TrainingProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  file                   StoredFile      @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([programId, submittedAt])
  @@index([fileId])
}

model SiteContent {
  key       String   @id @db.VarChar(60)
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------- Master data ----------

model Department {
  id           Int                @id @default(autoincrement())
  name         String             @unique @db.VarChar(120)
  createdAt    DateTime           @default(now())
  items        ChecklistItem[]
  assignments  AuditAssignment[]
  sopDocuments SopDocument[]
  exclusions   AuditorExclusion[]
}

// "Program"/unit materi (notulensi: 13 unit). Bukan departemen.
model MaterialCategory {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(160)
  description  String?       @db.Text
  sortOrder    Int           @default(0)
  // Hanya Programyang dipublikasikan yang tampil di halaman publik peserta.
  isPublished  Boolean       @default(false)
  sopDocuments SopDocument[]
}

model SopDocument {
  id             Int              @id @default(autoincrement())
  code           String           @unique @db.VarChar(60)
  title          String           @db.VarChar(255)
  categoryId     Int
  departmentId   Int? // pemilik SOP; null untuk materi umum
  pdfUrl         String?          @db.VarChar(1024) // hanya https; risiko akses dokumen internal dicatat di docs
  // Dokumen baru TIDAK publik secara bawaan; harus dipublikasikan eksplisit agar SOP internal tidak bocor.
  isPublished    Boolean          @default(false)
  category       MaterialCategory @relation(fields: [categoryId], references: [id])
  department     Department?      @relation(fields: [departmentId], references: [id])
  checklistItems ChecklistItem[]

  @@index([categoryId, isPublished])
  @@index([departmentId])
}

// ---------- Standar dan versi checklist ----------

model AuditStandard {
  id        Int                @id @default(autoincrement())
  code      String             @unique @db.VarChar(40) // mis. ISO37001
  name      String             @db.VarChar(160)
  createdAt DateTime           @default(now())
  versions  ChecklistVersion[]
}

model ChecklistVersion {
  id           Int                    @id @default(autoincrement())
  standardId   Int
  versionLabel String                 @db.VarChar(40)
  status       ChecklistVersionStatus @default(DRAFT)
  publishedAt  DateTime?
  retiredAt    DateTime?
  createdAt    DateTime               @default(now())
  standard     AuditStandard          @relation(fields: [standardId], references: [id], onDelete: Restrict)
  items        ChecklistItem[]
  sessions     AuditSession[]

  @@unique([standardId, versionLabel])
}

model ChecklistItem {
  id           Int               @id @default(autoincrement())
  versionId    Int
  departmentId Int // unit yang diaudit
  sopId        Int?
  criteria     String            @db.Text
  reference    String?           @db.VarChar(255)
  sortOrder    Int               @default(0)
  version      ChecklistVersion  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  department   Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  sop          SopDocument?      @relation(fields: [sopId], references: [id])
  answers      ChecklistAnswer[]

  @@unique([id, departmentId]) // target FK: jawaban hanya boleh memakai item dari unit penugasannya
  @@index([versionId, departmentId, sortOrder])
  @@index([sopId])
}

// ---------- Sesi, auditor, penugasan ----------

enum UserRole {
  ADMIN
  AUDITOR
}

// Akun internal Admin/Auditor. Sumber autentikasi utama; kata sandi disimpan sebagai hash bcrypt (tidak pernah plaintext).
model UserAccount {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(160) // disimpan huruf kecil
  name         String    @db.VarChar(120)
  passwordHash String    @db.VarChar(100)
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auditors     Auditor[] // penugasan ke sesi audit (hanya akun role AUDITOR)

  @@index([role, isActive])
}

model AuditSession {
  id                 Int               @id @default(autoincrement())
  title              String            @db.VarChar(160)
  checklistVersionId Int? // OPSIONAL: sesi tidak lagi wajib memakai Master Checklist (null = tanpa checklist)
  status             SessionStatus     @default(DRAFT)
  expiresAt          DateTime // batas waktu PENULISAN
  closedAt           DateTime?
  auditorAccessUntil DateTime? // jendela akses auditor setelah CLOSED; null = tidak ada akses
  findingSeq         Int               @default(0) // penghitung nomor temuan per sesi
  createdAt          DateTime          @default(now())
  checklistVersion   ChecklistVersion? @relation(fields: [checklistVersionId], references: [id], onDelete: Restrict)
  auditors           Auditor[]
  assignments        AuditAssignment[]

  documentHeader     AuditDocumentHeader?
  evidenceFiles      AuditEvidenceFile[]

  @@index([status, expiresAt])
  @@index([checklistVersionId])
}

// Auditor = penerima undangan per sesi. Nama BUKAN identitas.
// Invarian (dijaga service):
//  I1 tokenHash terisi => claimedAt terisi dan revokedAt kosong
//  I2 revokedAt terisi => tokenHash kosong
//  I3 undangan dapat diklaim hanya bila claimedAt kosong, revokedAt kosong, dan inviteExpiresAt > sekarang
model Auditor {
  id              Int                     @id @default(autoincrement())
  sessionId       Int
  name            String                  @db.VarChar(120)
  inviteHash      String                  @unique @db.VarChar(64) // SHA-256 token undangan
  inviteExpiresAt DateTime
  claimedAt       DateTime?
  revokedAt       DateTime?
  tokenHash       String?                 @unique @db.VarChar(64) // SHA-256 token sesi (cookie); null = tidak ada sesi login
  createdAt       DateTime                @default(now())
  session         AuditSession            @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  assignments     AuditAssignment[]
  exclusions      AuditorExclusion[]
  // Penugasan akun (pengganti undangan). Null = auditor lama hasil undangan (data historis, tidak dihapus).
  userId          Int?
  account         UserAccount?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  statusChanges   FindingStatusHistory[]

  @@unique([id, sessionId]) // target FK: penugasan hanya boleh menunjuk auditor dari sesi yang sama
  @@unique([sessionId, userId]) // satu akun hanya sekali per sesi (NULL pada data lama tidak bentrok)
  @@index([userId])
  @@index([sessionId])
}

// Pencegahan self-audit tanpa departemen asal: unit yang tidak boleh diaudit oleh auditor ini.
model AuditorExclusion {
  auditorId    Int
  departmentId Int
  createdAt    DateTime   @default(now())
  auditor      Auditor    @relation(fields: [auditorId], references: [id], onDelete: Restrict)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([auditorId, departmentId])
  @@index([departmentId])
}

model AuditAssignment {
  id           Int               @id @default(autoincrement())
  sessionId    Int
  auditorId    Int
  departmentId Int // unit yang diaudit
  createdAt    DateTime          @default(now())
  session      AuditSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  auditor      Auditor           @relation(fields: [auditorId, sessionId], references: [id, sessionId], onDelete: Restrict)
  department   Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  answers      ChecklistAnswer[]
  findings     Finding[]

  @@unique([sessionId, auditorId, departmentId])
  @@unique([id, departmentId]) // target FK: jawaban membawa unit penugasan
  @@unique([id, sessionId]) // target FK: temuan membawa sesi penugasan
  @@index([auditorId, sessionId])
  @@index([departmentId])
}

// Header formulir Laporan Ketidaksesuaian dan Tindakan Korektif, dapat diubah Auditor (satu baris per sesi).
model AuditDocumentHeader {
  id           Int          @id @default(autoincrement())
  sessionId    Int          @unique
  organization String       @db.VarChar(160)
  subtitle     String       @db.VarChar(200)
  formTitle    String       @db.VarChar(200)
  formCode     String       @db.VarChar(40)
  revision     String       @db.VarChar(40)
  issuedAt     String       @db.VarChar(40)
  updatedAt    DateTime     @updatedAt
  session      AuditSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
}

// ---------- Hasil audit ----------

// Berkas bukti yang diunggah Auditor (foto, PDF, Excel/Word). Disimpan di database agar ikut cadangan dan tidak
// bergantung pada disk server. Hanya dapat dibaca auditor pada sesi yang sama (dicek di rute /auditor/bukti).
model AuditEvidenceFile {
  id          Int          @id @default(autoincrement())
  sessionId   Int
  fileName    String       @db.VarChar(200)
  contentType String       @db.VarChar(100)
  sizeBytes   Int
  data        Bytes        @db.LongBlob
  createdAt   DateTime     @default(now())
  session     AuditSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
}

model ChecklistAnswer {
  id           Int             @id @default(autoincrement())
  assignmentId Int
  itemId       Int
  departmentId Int // salinan unit penugasan; FK komposit memastikan item dan penugasan satu unit
  result       AnswerResult? // null = belum dijawab
  note         String?         @db.Text
  evidenceUrl  String?         @db.VarChar(1024) // satu tautan bukti; multi-bukti menunggu konfirmasi
  itemSnapshot Json // salinan isi item saat jawaban pertama kali dibuat
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  assignment   AuditAssignment @relation(fields: [assignmentId, departmentId], references: [id, departmentId], onDelete: Restrict)
  item         ChecklistItem   @relation(fields: [itemId, departmentId], references: [id, departmentId], onDelete: Restrict)
  findings     Finding[]

  @@unique([assignmentId, itemId]) // satu jawaban per item per penugasan (upsert)
  @@unique([id, assignmentId]) // target FK: temuan hanya boleh menaut ke jawaban di penugasan yang sama
  @@index([itemId, departmentId])
  @@index([assignmentId, result])
}

model Finding {
  id                Int                    @id @default(autoincrement())
  sessionId         Int
  assignmentId      Int
  answerId          Int? // opsional: temuan boleh berdiri sendiri (menunggu konfirmasi klien)
  seq               Int // nomor urut per sesi; kode tampil T-{sessionId}-{seq} diturunkan, tidak disimpan
  clientRequestId   String                 @db.VarChar(64) // kunci idempotensi dari klien
  payloadHash       String                 @db.Char(64) // SHA-256 isi ternormalisasi
  classification    FindingClass
  problem           String                 @db.Text // PLOR: Problem
  location          String                 @db.Text // PLOR: Location
  objectiveEvidence String                 @db.Text // PLOR: Objective Evidence
  reference         String                 @db.Text // PLOR: Reference
  note              String?                @db.Text
  evidenceUrl       String?                @db.VarChar(1024)
  status            FindingStatus          @default(OPEN)
  closedAt          DateTime?
  // Tindak lanjut (formulir Laporan Ketidaksesuaian dan Tindakan Korektif). Diisi Auditor atas nama auditee.
  // Major/Minor: rootCause, correction*, correctiveAction*. Observasi: improvement*. Semua opsional.
  rootCause              String?           @db.Text
  correction             String?           @db.Text
  correctionPic          String?           @db.VarChar(160)
  correctionTarget       String?           @db.VarChar(80)
  correctiveAction       String?           @db.Text
  correctiveActionPic    String?           @db.VarChar(160)
  correctiveActionTarget String?           @db.VarChar(80)
  improvementAction      String?           @db.Text
  improvementPic         String?           @db.VarChar(160)
  improvementTarget      String?           @db.VarChar(80)
  improvementEvidenceUrl String?           @db.VarChar(1024) // bukti tindakan peningkatan (Observasi): berkas unggahan atau https
  // Register temuan (desain Audit): auditee, tanggal formulir (YYYY-MM-DD), verifikasi, dan tautan bukti tindakan (https).
  auditeeName            String?           @db.VarChar(160)
  reportedDate           String?           @db.VarChar(10)
  followedUpDate         String?           @db.VarChar(10)
  verifiedDate           String?           @db.VarChar(10)
  verifierName           String?           @db.VarChar(160)
  verificationResult     String?           @db.Text
  correctionEvidenceUrl  String?           @db.VarChar(1024)
  correctiveActionEvidenceUrl String?      @db.VarChar(1024)
  // Hapus lunak: baris tetap ada (nomor temuan tidak dipakai ulang), tetapi tidak tampil di daftar, hitungan, dan cetak.
  deletedAt              DateTime?
  deletedByAuditorId     Int? // bukan FK: jejak penghapus bertahan walau penugasan auditor dicabut
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  // FK komposit: penugasan harus berada di sesi yang sama dengan temuan.
  assignment        AuditAssignment        @relation(fields: [assignmentId, sessionId], references: [id, sessionId], onDelete: Restrict)
  // FK komposit: jika answerId terisi, jawaban itu wajib berada di assignmentId yang sama.
  answer            ChecklistAnswer?       @relation(fields: [answerId, assignmentId], references: [id, assignmentId], onDelete: Restrict)
  history           FindingStatusHistory[]

  @@unique([assignmentId, clientRequestId])
  @@unique([sessionId, seq])
  @@index([sessionId, status])
  @@index([assignmentId])
  @@index([answerId, assignmentId])
  @@index([classification])
}

model FindingStatusHistory {
  id                 Int            @id @default(autoincrement())
  findingId          Int
  fromStatus         FindingStatus? // null pada entri awal
  toStatus           FindingStatus
  changedByAuditorId Int
  note               String?        @db.Text
  createdAt          DateTime       @default(now())
  finding            Finding        @relation(fields: [findingId], references: [id], onDelete: Restrict)
  changedBy          Auditor        @relation(fields: [changedByAuditorId], references: [id], onDelete: Restrict)

  @@index([findingId, createdAt])
  @@index([changedByAuditorId])
}
